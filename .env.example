# === Panel del admin (sitio estático en Firebase Hosting) ===
# Passphrase del panel. OJO: las variables NEXT_PUBLIC_* quedan visibles en el
# bundle del navegador. Esta clave se usa como `adminKey` y las reglas de
# Firestore la comparan con `config/admin.key` (esa copia NO es legible por el
# cliente). Es un gate de UI + el permiso real de escritura.
NEXT_PUBLIC_ADMIN_SECRET_PHRASE=

# Path secreto del panel: /panel-editorial-9x4k/login
# La carpeta src/app/panel-editorial-9x4k/ ES la ruta (no hay middleware).
# Si lo cambias, renombra la carpeta y el bloque "/admin/**" en firebase.json.
ADMIN_SECRET_PATH=/panel-editorial-9x4k
NEXT_PUBLIC_ADMIN_SECRET_PATH=/panel-editorial-9x4k

# === Firebase (proyecto zentos-eeca4) ===
# Config publica del SDK web (no son secretas: las reglas de Firestore mandan).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zentos-eeca4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zentos-eeca4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=zentos-eeca4.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=776367388112
NEXT_PUBLIC_FIREBASE_APP_ID=

# Usados por los scripts y por el build (Admin SDK).
# El build lee scripts/blog-admin.mjs, que usa:
#   1) FIREBASE_SERVICE_ACCOUNT (JSON en una linea), o
#   2) firebase-service-account.local.json (local, gitignored), o
#   3) Application Default Credentials (gcloud auth application-default login)
FIREBASE_PROJECT_ID=zentos-eeca4
FIREBASE_STORAGE_BUCKET=zentos-eeca4.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT=

# API key de Unsplash para buscar imagenes libres en el admin del blog.
# Gratis en: https://unsplash.com/developers
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=

# URL de notificacion del formulario de contacto (webhook opcional).
# Sin esto, los leads quedan en Firestore y se ven en la consola de Firebase.
CONTACT_WEBHOOK_URL=
