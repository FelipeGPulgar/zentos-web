# URL de notificación del formulario de contacto.
# Acepta webhooks de Discord, Slack o cualquier endpoint que reciba JSON.
# Sin esta variable, los leads se guardan igualmente en data/leads.jsonl.
CONTACT_WEBHOOK_URL=

# Contraseña del panel de administración del blog
ADMIN_PASSWORD=

# Secreto para firmar la sesión del admin (genera uno largo y aleatorio)
ADMIN_SESSION_SECRET=

# Path secreto del admin (cambialo por algo que solo tu conozcas).
# Acceder en: https://tu-dominio.com/TU-PATH-SECRETO/login
# Si lo cambias, tambien actualiza el matcher en src/middleware.ts
ADMIN_SECRET_PATH=/panel-editorial-9x4k

# Debe ser IGUAL a ADMIN_SECRET_PATH. Lo usa el navegador para redirigir.
NEXT_PUBLIC_ADMIN_SECRET_PATH=/panel-editorial-9x4k

# API key de Unsplash para buscar imágenes libres en el admin del blog.
# Gratis en: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
